    override_dirs   = [os.path.join(cwd, 'macos')]
    excluded_in_src = {
        'VStatusButton.java', 'LayoutBuilder.java', 'ExpPanel.java',
        'VnmrCanvas.java', 'ButtonIF.java', 'CanvasIF.java',
