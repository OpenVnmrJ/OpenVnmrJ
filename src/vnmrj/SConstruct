classesPath = os.path.join(cwd, 'classes')
if not os.path.exists(classesPath):
    os.makedirs(classesPath)

# actions to perform at interpretation time
# define with absolute path where built files will be copied
installPath = os.path.join(cwd, os.pardir, os.pardir, os.pardir, 'vnmr', 'java')
# make sure the path(s) exist
if not os.path.exists(installPath):
    os.makedirs(installPath)

def unpack_jar(target, source, env):
    import subprocess
    for jar in source:
        subprocess.check_call([jarBin, '-xf', jar.get_abspath()],
                              cwd=classesPath)
    meta_inf = os.path.join(classesPath, 'META-INF')
    if os.path.exists(meta_inf):
        import shutil as _shutil
        _shutil.rmtree(meta_inf)
    return None

ThirdPartyJarPath = os.path.join(ovjtools, 'JavaPackages')

ThirdPartyJarNames = [
    'gluegen-rt.jar',
    'jogl-all.jar',
    'postgresql.jar',
    'JTattoo.jar',
    'xml.jar',
    'jmol.jar',
    'jh.jar',
    'jhall.jar',
    'jhbasic.jar',
    'jhtools.jar',
    'jsearch.jar',
]
if with_lc:
    ThirdPartyJarNames += ['lcaccess.jar', 'msaccess.jar', 'pdaaccess.jar']

for _jar in ThirdPartyJarNames:
    _src = os.path.join(ThirdPartyJarPath, _jar)
    if os.path.exists(_src):
        shutil.copy(_src, os.path.join(cwd, _jar))

java6dir = os.path.join(ovjtools, 'java', 'bin', 'javaws')
if os.path.exists(java6dir):
    env.Install(os.path.join('src', 'vnmr', 'ui'),
                Glob(os.path.join('java6', '*')))

pathEnv = javaBinDir + ':' + os.environ.get('PATH', '')

if platform == 'darwin':
    if 'JAVA_HOME' not in os.environ:
        import subprocess
        os.environ['JAVA_HOME'] = subprocess.check_output(
            ['/usr/libexec/java_home', '-v', '1.8']).decode().strip()

commonEnvDict = {
    'JAVA_HOME': os.environ.get('JAVA_HOME', javaBinDir),
    'PATH':      pathEnv,
}

all_cp_jars = jarFileList + jarHelpFileList
if with_lc:
    all_cp_jars += lc_jar_list

classpath_for_build = ':'.join([classesPath] + all_cp_jars)

jEnv = Environment(ENV=dict(commonEnvDict, CLASSPATH=classpath_for_build))

print("Java build ENV:", jEnv['ENV'])
jEnv.Execute('which javac')

jars_to_unpack = jarFileList + jarHelpFileList
if with_lc:
    jars_to_unpack += lc_jar_list

def sync_vnmr_props(target, source, env):
    """Copy src/vnmr property tree into classesPath/vnmr."""
    dst = os.path.join(classesPath, 'vnmr')
    if os.path.exists(dst):
        shutil.rmtree(dst)
    shutil.copytree(os.path.join(cwd, 'src', 'vnmr'), dst)
    return None

unpackNode = env.Command(
    target = os.path.join(classesPath, '.jars_unpacked'),
    source = jars_to_unpack,
    action = [
        unpack_jar,
        sync_vnmr_props,
        Touch('$TARGET'),
    ],
)

todaysDate   = datetime.datetime.now().strftime("%B %e, %Y %T %Z")
manifestFile = os.path.join(cwd, 'Manifest')
with open(manifestFile, 'w') as mf:
    mf.write('Manifest-Version: 1.0 ' + todaysDate + '\n')
    mf.write('Main-Class: vnmr.ui.VNMRFrame\n')

def collect_java_files(directories, exclude_files=None):
    """Walk directories and return all .java files, excluding given basenames."""
    exclude_files = set(exclude_files or [])
    found = []
    for d in directories:
        for root, dirs, files in os.walk(d):
            for f in sorted(files):
                if f.endswith('.java') and f not in exclude_files:
                    found.append(os.path.join(root, f))
    return found

