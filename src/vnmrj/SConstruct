                       os.path.join(cwd, 'linux')]
    excluded_in_src = {
        'VStatusButton.java', 'LayoutBuilder.java',
        'ExpPanel.java',
        'CorbaClient.java', 'VMsStatusButton.java',
        'LcCorbaClient.java', 'MsCorbaClient.java', 'PdaCorbaClient.java',
        'VnmrTearCanvas.java',
    }

def collect_src_files(src_root, exclude_files, exclude_lc):
    """Walk src_root, skipping excluded filenames and optionally the lc/ tree."""
    found = []
    for root, dirs, files in os.walk(src_root):
        if exclude_lc and os.path.basename(root) == 'lc':
            dirs[:] = []
            continue
        for f in sorted(files):
            if f.endswith('.java') and f not in exclude_files:
                found.append(os.path.join(root, f))
    return found

exclude_lc_tree = (platform == 'darwin') or (not with_lc)

if platform.startswith('linux'):
    macos_exclude = {'ButtonIF.java', 'CanvasIF.java', 'VnmrCanvas.java'}
    if not with_lc:
        macos_exclude.add('ExpPanel.java')
else:
    macos_exclude = set()

all_java_files = collect_src_files(os.path.join(cwd, 'src'),
                                    excluded_in_src, exclude_lc_tree)
if platform == 'darwin' or (not with_lc and platform.startswith('linux')):
    all_java_files += collect_java_files([os.path.join(cwd, 'macos')],
                                          macos_exclude)
if not with_lc and platform.startswith('linux'):
    all_java_files += collect_java_files([os.path.join(cwd, 'linux')])

javacBin = os.path.join(javaBinDir, 'javac')
javacSentinel = os.path.join(classesPath, '.javac_done')

def _java_major_version(javac_bin):
    try:
        import subprocess as _sp
        out = _sp.check_output([javac_bin, '-version'],
                               stderr=_sp.STDOUT).decode().strip()
        ver = out.split()[-1]
        parts = ver.split('.')
        major = int(parts[0])
        return 8 if major == 1 else major 
    except Exception:
        return 8 

java_major = _java_major_version(javacBin)
print('Java major version: %d' % java_major)

if java_major >= 9 and platform.startswith('linux'):
    java9_exports = [
        '--add-exports', 'java.desktop/com.sun.java.swing.plaf.motif=ALL-UNNAMED',
        '--add-exports', 'java.desktop/sun.awt=ALL-UNNAMED',
    ]
else:
    java9_exports = []

def run_javac(target, source, env):
    import subprocess
    cmd = ([javacBin, '-J-mx256m'] +
            java9_exports +
            ['-d',          classesPath,
            '-classpath',  classpath_for_build,
            '-sourcepath', os.path.join(cwd, 'src')] +
           [str(s) for s in source])
    subprocess.check_call(cmd)
    return None

javaBuildObject = env.Command(
    target = javacSentinel,
    source = all_java_files,
    action = [run_javac, Touch('$TARGET')],
)
Depends(javaBuildObject, unpackNode)
Depends(javaBuildObject, vjmolSiblingJar)

# Jar + install after compile
jarAndInstall = (
    'cd ' + cwd +
    ' && ' + jarBin + ' cfm vnmrj.jar Manifest -C classes .'
    ' && cp ' + os.path.join(cwd, vnmrjTarget) + ' ' + installPath
)
env.AddPostAction(javaBuildObject, Action(jarAndInstall))

moviePath = os.path.join(ovjtools, 'JMF-2.1.1e', 'src', 'simplemovie.jar')
env.Install(installPath, moviePath)

# vjmolSiblingJar resolves to  /src/vjmol/vjmol.jar
env.Install(installPath, vjmolSiblingJar)
